generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Book {
  id          String   @id @default(cuid())
  title       String
  author      String
  totalPages  Int?
  pagesRead   Int      @default(0)
  status      String   @default("READING")
  notes       String?
  finishedAt  DateTime?
  droppedAt   DateTime?
  userId      String
  source      String   @default("manual")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  genres      Genre[]
  tags        Tag[]
}

model Genre {
  id     String @id @default(cuid())
  name   String
  userId String
  books  Book[]

  @@unique([userId, name])
}

model Tag {
  id     String @id @default(cuid())
  name   String
  userId String
  books  Book[]

  @@unique([userId, name])
}
